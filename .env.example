# StudioSpace Server Environment Configuration
PORT=5000
# Enter your MongoDB connection URI below (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/studiospace?retryWrites=true&w=majority
# JWT Secret key for signing tokens
JWT_SECRET=studiospace_secure_jwt_secret_token_987654321
# Client application URL for CORS and cookies
CLIENT_URL=http://localhost:3000
NODE_ENV=development

